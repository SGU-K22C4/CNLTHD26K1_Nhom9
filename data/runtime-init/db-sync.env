# Duoc tao tu cac config dang co trong repo.
# Cho MySQL server, repo hien KHONG co host/user/password that nen van de placeholder.

# ===== Local MySQL =====
LOCAL_MYSQL_CONTAINER=fashion_mysql
LOCAL_MYSQL_ROOT_PASSWORD=huytran123

# ===== Server MySQL =====
SERVER_MYSQL_HOST=127.0.0.1
SERVER_MYSQL_PORT=3308
SERVER_MYSQL_USER=root
SERVER_MYSQL_PASSWORD=huytran123

# ===== Local/Dev Mongo =====
# Review dev lay tu backend/config-repo/review-service-dev.yml
LOCAL_REVIEW_MONGO_URI=mongodb+srv://monimal1:huytran123@monimal1.meiqp1v.mongodb.net/fashion_review_db?retryWrites=true&w=majority&appName=monimal1

# Chatbot dev file config hien dang typo host `meiqplv`; runtime docker-compose va review dev
# deu dung `meiqp1v`, nen o day chot theo host da verify dung.
LOCAL_CHATBOT_MONGO_URI=mongodb+srv://monimal1:huytran123@monimal1.meiqp1v.mongodb.net/fashion_chatbot_db?retryWrites=true&w=majority&appName=monimal1

# ===== Server/Prod Mongo =====
# Lay host va db name tu backend/config-repo/*-prod.yml, khong copy secret vao file.
SERVER_REVIEW_MONGO_URI=mongodb+srv://monimal:huytran123@monimal.bv37www.mongodb.net/fashion_review_db?retryWrites=true&w=majority&appName=Monimal
SERVER_CHATBOT_MONGO_URI=mongodb+srv://monimal:huytran123@monimal.bv37www.mongodb.net/fashion_chatbot_db?retryWrites=true&w=majority&appName=Monimal
