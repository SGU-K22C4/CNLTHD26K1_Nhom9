# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG DÀNH CHO DEVELOPER (TEAM WORKFLOW)
# ==============================================================================
# 1. Đổi tên file này thành .env (File .env đã được cấu hình ẩn trong .gitignore).
# 2. LOCAL: Điền thông tin kết nối vào database do bạn tự dựng ở máy (XAMPP/Docker).
#           Hãy tự tạo Schema (fashion_user_db, fashion_order_db...), bật app 
#           để Flyway tự tạo bảng, thoải mái code và test dữ liệu ảo.
# 3. PRODUCTION/STAGING: Khi test local ok, hãy comment block LOCAL lại, 
#           uncomment block PRODUCTION và kết nối vào DB chung để test chéo.
# file .env tại docker sẽ dành cho hạ tầng/ DevOps
# Nhiệm vụ: Tiêm biến môi trường vào trong ruột của các container Linux lúc nó khởi tạo. 
# Ví dụ: Dùng để thiết lập mật khẩu root cho cục MySQL (MYSQL_ROOT_PASSWORD), hoặc gửi JWT_SECRET cho Kong Gateway để Kong có thể chặn ném token sai ngay từ ngoài cổng.
# Code Java: Không hề hay biết sự tồn tại của file này (vì nó nằm ngoài scope thư mục backend).
# ==============================================================================

# ── [1] CẤU HÌNH LOCAL (Dùng cho từng máy cá nhân) ────────────────────────────
SPRING_PROFILE=local
MYSQL_ROOT_PASSWORD=huytran123
DB_HOST=localhost
DB_USER=root
# DB_PASSWORD=        # (Bỏ trống nếu xài XAMPP, điền huytran123 nếu xài Docker)
KAFKA_BROKER=localhost:9092
REDIS_HOST=localhost
MONGO_HOST=localhost

# ── [2] CẤU HÌNH PRODUCTION (Dùng chung cho cả Team test) ─────────────────────
# (Comment phần LOCAL ở trên và MỞ phần này khi muốn connect DB dùng chung)
# SPRING_PROFILE=production
# MYSQL_ROOT_PASSWORD=production_secret_password_here
# DB_HOST=ip_hoac_domain_cua_vps_server
# DB_USER=admin_db
# DB_PASSWORD=mat_khau_server_chinh
# KAFKA_BROKER=vps_ip:9092
# REDIS_HOST=vps_ip
# MONGO_HOST=vps_ip

# ==============================================================================
# CÁC BIẾN DÙNG CHUNG (KHÔNG ĐỔI GIỮA LOCAL/PROD MÀ DÙNG CHUNG SECRET)
# ==============================================================================

# ── JWT (Base64-encoded secret, >= 32 bytes) ──────────────────────────────────
# ⚠️ This value is shared between ALL Spring Boot services AND Kong Gateway.
JWT_SECRET=fdf96e94a86f9a039751e39a38f3d61b4db1b138bd3db18e97fef29d0eb6efab

# ── Mail (Gmail App Password) ─────────────────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ── App URLs & External APIs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
