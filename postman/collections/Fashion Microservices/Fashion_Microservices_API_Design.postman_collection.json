                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"fullName\": \"Postman User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/register",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "register"]
                },
                "description": "Public register endpoint."
              }
            },
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/v1/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "auth", "login"]
                },
                "description": "Public login endpoint."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  const data = pm.response.json();",
                      "  if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                      "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                      "  if (data.user && data.user.id) pm.collectionVariables.set('xUserId', String(data.user.id));",
                      "  if (data.user && data.user.role) pm.collectionVariables.set('xUserRole', String(data.user.role));",
                      "}"
                    ]
                  }
                }
              ]
            },
