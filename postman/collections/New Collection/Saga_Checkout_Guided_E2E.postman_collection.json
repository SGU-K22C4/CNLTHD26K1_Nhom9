      "item": [
        {
          "name": "Kong Admin Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8001/",
              "host": ["http://localhost:8001"],
              "path": [""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Kong admin reachable', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
