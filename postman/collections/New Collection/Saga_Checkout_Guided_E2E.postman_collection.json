    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "xUserId", "value": "postman-saga-user" },
    { "key": "vnpHashSecret", "value": "V0UJ9R7MWMJLFJREF60KQR5P9RO1XIYH" },

    { "key": "productId", "value": "02a6ad8f-6f1e-45cd-b4ca-beab32a99668" },
